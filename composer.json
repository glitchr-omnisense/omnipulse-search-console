{
    "name": "omnipulse/search-console",
    "type": "library",
    "description": "Omnipulse's Google Search Console, under any PHP host: a property's search queries, pages, countries and devices with their clicks, impressions, CTR and average position, day by day or over a period, through the Search Console API (a service account's key or an access token).",
    "keywords": [
        "google",
        "search-console",
        "seo",
        "search",
        "queries",
        "positions",
        "framework-agnostic",
        "omnipulse"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnipulse-search-console",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnipulse": "^1.0@dev",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "replace": {
        "omnireach/search-console": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Omnipulse\\SearchConsole\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipulse\\SearchConsole\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
